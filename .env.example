# Copy to .env and fill in. Never commit .env.
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=gemma4
SUPERMEMORY_API_KEY=
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=
# "instant" makes memories searchable right away (tests); "dynamic" batches (production default)
SM_DREAMING=instant
# repo the evals ask about; should have failed runs that have jobs
EVAL_REPO=owner/repo
